# Kopiér til .env.local og udfyld. Læg aldrig rigtige nøgler i git.
# Lokalt: værdierne vises af `npm run db:start` (eller `npx supabase status`).
# Test/drift: sættes som miljøvariabler i Vercel.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Kun serveren. Bruges til at oprette brugere og nulstille koder. Må aldrig have NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Backup af timer på e-mail (Resend, EU). Kun serveren. Uden nøgle sendes der ingen mails.
RESEND_API_KEY=
# Valgfri afsender; skal være på et domæne, der er godkendt i Resend.
# BACKUP_FROM="Vixx backup <backup@mail.vixx.dk>"
# Beskytter den natlige kørsel (/api/backup). Vercel Cron sender den automatisk.
CRON_SECRET=
